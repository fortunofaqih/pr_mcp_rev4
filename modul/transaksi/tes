/* PERMITTED COMMANDS 
   move(); turnLeft(); turnRight(); treeLeft(); treeRight(); treeFront(); onLeaf(); putLeaf(); removeLeaf(); mushroomFront();
   onLeaf(x, y); putLeaf(x,y); removeLeaf(x,y); for sensing, adding or removing a leaf at coordinate (x,y)
   onFire(x, y); putFire(x,y); removeFire(x,y); for sensing, adding or removing a leaf at coordinate (x,y)
   getX(); getY(); for obtaining the current coordinates of Clara
   JAVA
   if, while, for, do, &&, ||, !
   variables, arrays
*/

class MyClara extends Clara {
    // Ukuran dunia Clara yang bernilai tetap (Konstan)
    final int WORLD_HEIGHT = 30;
    final int WORLD_WIDTH = 40;

    // Status dunia: 0 = Kosong, 1 = Daun, 2 = Api
    int[][] currentWorldState;
    int[][] nextWorldState;

    void run()
    {
        // Pengecekan apakah dunia masih benar-benar kosong (Pertama kali dijalankan)
        if (isWorldEmpty()) {
            // Tugas 1: Membuat metode populasi acak dengan probabilitas 50% tanpa Random import
            populateWorldRandomly();
        }

        // Ambil status dunia saat ini ke dalam array
        currentWorldState = worldToArray();

        // Clara bertindak sebagai titik api (Ignition point). 
        // Taruh api di posisi Clara saat ini pada state sekarang sebelum aturan diterapkan
        int claraX = getX();
        int claraY = getY();
        currentWorldState[claraX][claraY] = 2; 

        // Tugas 3: Modifikasi aturan dari Game of Life menjadi Aturan Penyebaran Api
        nextWorldState = applyFireSpreadRules(currentWorldState);
        
        // Perbarui tampilan visual dunia Clara
        updateWorld(nextWorldState);
    }

    /**
     * Memeriksa apakah dunia Clara masih kosong (belum di-populate)
     */
    boolean isWorldEmpty() {
        for (int i = 0; i < WORLD_WIDTH; i++) {
            for (int k = 0; k < WORLD_HEIGHT; k++) {
                if (onLeaf(i, k) || onFire(i, k)) {
                    return false;
                }
            }
        }
        return true;
    }

    /**
     * Mengisi dunia secara acak dengan daun menggunakan Math.random() (probabilitas p = 50%)
     */
    void populateWorldRandomly() {
        for (int i = 0; i < WORLD_WIDTH; i++) {
            for (int k = 0; k < WORLD_HEIGHT; k++) {
                // Math.random() menghasilkan nilai 0.0 sampai 1.0. 
                // Jika < 0.5, berarti peluangnya pas 50% untuk menaruh daun
                if (Math.random() < 0.5) {
                    putLeaf(i, k);
                }
            }
        }
    }

    /**
     * Membaca kondisi objek di grid Clara ke dalam array integer
     */
    int[][] worldToArray()
    {
        int[][] retVal = new int[WORLD_WIDTH][WORLD_HEIGHT];

        for (int i = 0; i < WORLD_WIDTH; i++)
        {
            for (int k = 0; k < WORLD_HEIGHT; k++)
            {
                if (onFire(i, k))
                    retVal[i][k] = 2; // Api (Mushroom)
                else if (onLeaf(i, k))
                    retVal[i][k] = 1; // Daun
                else                
                    retVal[i][k] = 0; // Kosong
            }
        }
        return retVal;
    }

    /**
     * Menerapkan Aturan Penyebaran Api (Fire Spread Rules)
     */
    int[][] applyFireSpreadRules(int[][] inInitialArray)
    {
        int[][] resultingArray = new int[WORLD_WIDTH][WORLD_HEIGHT];

        for (int i = 0; i < WORLD_WIDTH; i++)
        {
            for (int k = 0; k < WORLD_HEIGHT; k++)
            {
                if (inInitialArray[i][k] == 2) {
                    // Aturan: Sel yang tadinya api (t-1) akan padam/kosong pada timestep berikutnya (t)
                    resultingArray[i][k] = 0;
                } 
                else if (inInitialArray[i][k] == 1) {
                    // Aturan: Sel daun akan terbakar jika minimal ada 1 dari 4 tetangganya yang terbakar
                    if (hasBurningNeighbor(inInitialArray, i, k)) {
                        resultingArray[i][k] = 2; // Berubah jadi api
                    } else {
                        resultingArray[i][k] = 1; // Tetap daun
                    }
                } 
                else {
                    resultingArray[i][k] = 0; // Tetap kosong
                }
            }
        }
        return resultingArray;
    }

    /**
     * Memeriksa 4 arah mata angin (Utara, Timur, Selatan, Barat) apakah ada api
     */
    boolean hasBurningNeighbor(int[][] inArray, int x, int y)
    {
        // Barat (x - 1)
        if (x > 0 && inArray[x - 1][y] == 2) return true;
        // Timur (x + 1)
        if (x < WORLD_WIDTH - 1 && inArray[x + 1][y] == 2) return true;
        // Utara (y - 1)
        if (y > 0 && inArray[x][y - 1] == 2) return true;
        // Selatan (y + 1)
        if (y < WORLD_HEIGHT - 1 && inArray[x][y + 1] == 2) return true;

        return false;
    }

    /**
     * Membersihkan seluruh isi dunia Clara sebelum digambar ulang
     */
    void cleanWorld()
    {
        for (int i = 0; i < WORLD_WIDTH; i++)
        {
            for (int k = 0; k < WORLD_HEIGHT; k++)
            {
                if (onLeaf(i, k)) removeLeaf(i, k);
                if (onFire(i, k)) removeFire(i, k);
            }
        }
    }

    /**
     * Menggambar ulang objek di dunia Clara berdasarkan status array yang baru
     */
    void updateWorld(int[][] inArray)
    {
        cleanWorld();

        for (int i = 0; i < WORLD_WIDTH; i++)
        {
            for (int k = 0; k < WORLD_HEIGHT; k++)
            {
                if (inArray[i][k] == 1) {
                    putLeaf(i, k);
                } else if (inArray[i][k] == 2) {
                    putFire(i, k);
                }
            }
        }
    }
}
	